  m_Script: {fileID: 11500000, guid: ba5d9bb11080f4081887088b50c7bf80, type: 3}
  m_Name: AnimalsPerson
  m_EditorClassIdentifier: GameAssembly::Person
  icon: {fileID: 0}
  positiveComment:
  - "Есть! Зверьки снова на высоте!"
  - "Попадание! Гении, завидуйте молча."
  - "В яблочко! Зверёк как всегда точен."
  - "Есть пробоина! Гении бы не смогли."
  - "Зверьки решают, гении конспектируют."
  - "Прямое попадание! Учитесь, гении."
  - "Есть! А кто говорил про алгоритмы?"
  - "Попал! Зверёк — интуиция, не формулы."
  - "Есть контакт! Гении в шоке молчат."
  - "Зверьки топят, гении считают шансы."
  - "Есть! Балл зверькам, ноль занудам."
  - "Пробоина! Гении, записывайте методику."
  - "Есть! Инстинкт зверька не подводит."
  - "Ещё один! Гении опять что-то доказывают."
  - "Зверьки бьют по факту, не по теории."
  - "Есть! Зверёк играет без документации."
  - "Попадание! Даже без диаграммы связей."
  - "Зверьки бьют интуицией, не таблицами."
  - "Попал! Гении, конспектируйте технику."
  - "Есть контакт! Зверёк не читал мануалы."
  - "Пробоина! А кто говорил про схемы?"
  - "Есть! Зверьки играют на глазок и метко."
  - "Попадание! Без единого запроса к базе."
  negativeComment:
  - "Мимо! Но зверёк всё равно красавчик."
  - "Промах, зато со стилем."
  - "Мимо! Это гений сглазил, не я."
  - "Ну мимо. Зверьки бьют реже, но метче."
  - "Промах! Зато харизма зашкаливает."
  - "Мимо, но зверёк уже придумал оправдание."
  - "Ай, мимо. Спишем на гениальную помеху."
  - "Промах! Зверьки играют в долгую."
  - "Мимо! Один раз можно, я же не гений."
  - "Ну не попал. Зато выгляжу солиднее."
  - "Промах, но зверёк не расстраивается."
  - "Мимо! Гении тоже так могут. Иногда."
  - "Ай, мимо. Зверёк просто разогревается."
  - "Промах! Но статус зверька не пострадал."
  - "Мимо, зато без занудных расчётов."
  - "Мимо! Зверёк просто решил передохнуть."
  - "Промах, но зверёк душа компании."
  - "Мимо! Один промах не считается."
  - "Промах! Гении, не злорадствуйте."
  - "Мимо, зато зверёк красивее всех."
  - "Промах! Зато без единой строчки кода."
  - "Зверёк играет для души, не для очков."
  - "Промах, но харизма всё компенсирует."
