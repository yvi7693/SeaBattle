  m_Script: {fileID: 11500000, guid: ba5d9bb11080f4081887088b50c7bf80, type: 3}
  m_Name: AnimalsPerson
  m_EditorClassIdentifier: GameAssembly::Person
  icon: {fileID: 7342110433142919881, guid: d16d5a6710fa6440c88a31dd6be2d679, type: 3}
  positiveComment:
  - "\u0415\u0441\u0442\u044C! \u0417\u0432\u0435\u0440\u044C\u043A\u0438 \u0441\u043D\u043E\u0432\u0430
    \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435!"
  - "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435! \u0413\u0435\u043D\u0438\u0438,
    \u0437\u0430\u0432\u0438\u0434\u0443\u0439\u0442\u0435 \u043C\u043E\u043B\u0447\u0430."
  - "\u0412 \u044F\u0431\u043B\u043E\u0447\u043A\u043E! \u0417\u0432\u0435\u0440\u0451\u043A
    \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u043E\u0447\u0435\u043D."
  - "\u0415\u0441\u0442\u044C \u043F\u0440\u043E\u0431\u043E\u0438\u043D\u0430! \u0413\u0435\u043D\u0438\u0438
    \u0431\u044B \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438."
  - "\u0417\u0432\u0435\u0440\u044C\u043A\u0438 \u0440\u0435\u0448\u0430\u044E\u0442,
    \u0433\u0435\u043D\u0438\u0438 \u043A\u043E\u043D\u0441\u043F\u0435\u043A\u0442\u0438\u0440\u0443\u044E\u0442."
  - "\u041F\u0440\u044F\u043C\u043E\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435!
    \u0423\u0447\u0438\u0442\u0435\u0441\u044C, \u0433\u0435\u043D\u0438\u0438."
  - "\u0415\u0441\u0442\u044C! \u0410 \u043A\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043B
    \u043F\u0440\u043E \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u044B?"
  - "\u041F\u043E\u043F\u0430\u043B! \u0417\u0432\u0435\u0440\u0451\u043A \u2014
    \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044F, \u043D\u0435 \u0444\u043E\u0440\u043C\u0443\u043B\u044B."
  - "\u0415\u0441\u0442\u044C \u043A\u043E\u043D\u0442\u0430\u043A\u0442! \u0413\u0435\u043D\u0438\u0438
    \u0432 \u0448\u043E\u043A\u0435 \u043C\u043E\u043B\u0447\u0430\u0442."
  - "\u0417\u0432\u0435\u0440\u044C\u043A\u0438 \u0442\u043E\u043F\u044F\u0442, \u0433\u0435\u043D\u0438\u0438
    \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u0448\u0430\u043D\u0441\u044B."
  - "\u0415\u0441\u0442\u044C! \u0411\u0430\u043B\u043B \u0437\u0432\u0435\u0440\u044C\u043A\u0430\u043C,
    \u043D\u043E\u043B\u044C \u0437\u0430\u043D\u0443\u0434\u0430\u043C."
  - "\u041F\u0440\u043E\u0431\u043E\u0438\u043D\u0430! \u0413\u0435\u043D\u0438\u0438,
    \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0439\u0442\u0435 \u043C\u0435\u0442\u043E\u0434\u0438\u043A\u0443."
  - "\u0415\u0441\u0442\u044C! \u0418\u043D\u0441\u0442\u0438\u043D\u043A\u0442 \u0437\u0432\u0435\u0440\u044C\u043A\u0430
    \u043D\u0435 \u043F\u043E\u0434\u0432\u043E\u0434\u0438\u0442."
  - "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D! \u0413\u0435\u043D\u0438\u0438
    \u043E\u043F\u044F\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442."
  - "\u0417\u0432\u0435\u0440\u044C\u043A\u0438 \u0431\u044C\u044E\u0442 \u043F\u043E
    \u0444\u0430\u043A\u0442\u0443, \u043D\u0435 \u043F\u043E \u0442\u0435\u043E\u0440\u0438\u0438."
  - "\u0415\u0441\u0442\u044C! \u0417\u0432\u0435\u0440\u0451\u043A \u0438\u0433\u0440\u0430\u0435\u0442
    \u0431\u0435\u0437 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438."
  - "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435! \u0414\u0430\u0436\u0435
    \u0431\u0435\u0437 \u0434\u0438\u0430\u0433\u0440\u0430\u043C\u043C\u044B \u0441\u0432\u044F\u0437\u0435\u0439."
  - "\u0417\u0432\u0435\u0440\u044C\u043A\u0438 \u0431\u044C\u044E\u0442 \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u0435\u0439,
    \u043D\u0435 \u0442\u0430\u0431\u043B\u0438\u0446\u0430\u043C\u0438."
  - "\u041F\u043E\u043F\u0430\u043B! \u0413\u0435\u043D\u0438\u0438, \u043A\u043E\u043D\u0441\u043F\u0435\u043A\u0442\u0438\u0440\u0443\u0439\u0442\u0435
    \u0442\u0435\u0445\u043D\u0438\u043A\u0443."
  - "\u0415\u0441\u0442\u044C \u043A\u043E\u043D\u0442\u0430\u043A\u0442! \u0417\u0432\u0435\u0440\u0451\u043A
    \u043D\u0435 \u0447\u0438\u0442\u0430\u043B \u043C\u0430\u043D\u0443\u0430\u043B\u044B."
  - "\u041F\u0440\u043E\u0431\u043E\u0438\u043D\u0430! \u0410 \u043A\u0442\u043E
    \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043F\u0440\u043E \u0441\u0445\u0435\u043C\u044B?"
  - "\u0415\u0441\u0442\u044C! \u0417\u0432\u0435\u0440\u044C\u043A\u0438 \u0438\u0433\u0440\u0430\u044E\u0442
    \u043D\u0430 \u0433\u043B\u0430\u0437\u043E\u043A \u0438 \u043C\u0435\u0442\u043A\u043E."
  - "\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435! \u0411\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E
    \u0437\u0430\u043F\u0440\u043E\u0441\u0430 \u043A \u0431\u0430\u0437\u0435."
  negativeComment:
  - "\u041C\u0438\u043C\u043E! \u041D\u043E \u0437\u0432\u0435\u0440\u0451\u043A
    \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043A\u0440\u0430\u0441\u0430\u0432\u0447\u0438\u043A."
  - "\u041F\u0440\u043E\u043C\u0430\u0445, \u0437\u0430\u0442\u043E \u0441\u043E
    \u0441\u0442\u0438\u043B\u0435\u043C."
  - "\u041C\u0438\u043C\u043E! \u042D\u0442\u043E \u0433\u0435\u043D\u0438\u0439
    \u0441\u0433\u043B\u0430\u0437\u0438\u043B, \u043D\u0435 \u044F."
  - "\u041D\u0443 \u043C\u0438\u043C\u043E. \u0417\u0432\u0435\u0440\u044C\u043A\u0438
    \u0431\u044C\u044E\u0442 \u0440\u0435\u0436\u0435, \u043D\u043E \u043C\u0435\u0442\u0447\u0435."
  - "\u041F\u0440\u043E\u043C\u0430\u0445! \u0417\u0430\u0442\u043E \u0445\u0430\u0440\u0438\u0437\u043C\u0430
    \u0437\u0430\u0448\u043A\u0430\u043B\u0438\u0432\u0430\u0435\u0442."
  - "\u041C\u0438\u043C\u043E, \u043D\u043E \u0437\u0432\u0435\u0440\u0451\u043A
    \u0443\u0436\u0435 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u0438\u0435."
  - "\u0410\u0439, \u043C\u0438\u043C\u043E. \u0421\u043F\u0438\u0448\u0435\u043C
    \u043D\u0430 \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043E\u043C\u0435\u0445\u0443."
  - "\u041F\u0440\u043E\u043C\u0430\u0445! \u0417\u0432\u0435\u0440\u044C\u043A\u0438
    \u0438\u0433\u0440\u0430\u044E\u0442 \u0432 \u0434\u043E\u043B\u0433\u0443\u044E."
  - "\u041C\u0438\u043C\u043E! \u041E\u0434\u0438\u043D \u0440\u0430\u0437 \u043C\u043E\u0436\u043D\u043E,
    \u044F \u0436\u0435 \u043D\u0435 \u0433\u0435\u043D\u0438\u0439."
  - "\u041D\u0443 \u043D\u0435 \u043F\u043E\u043F\u0430\u043B. \u0417\u0430\u0442\u043E
    \u0432\u044B\u0433\u043B\u044F\u0436\u0443 \u0441\u043E\u043B\u0438\u0434\u043D\u0435\u0435."
  - "\u041F\u0440\u043E\u043C\u0430\u0445, \u043D\u043E \u0437\u0432\u0435\u0440\u0451\u043A
    \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
  - "\u041C\u0438\u043C\u043E! \u0413\u0435\u043D\u0438\u0438 \u0442\u043E\u0436\u0435
    \u0442\u0430\u043A \u043C\u043E\u0433\u0443\u0442. \u0418\u043D\u043E\u0433\u0434\u0430."
  - "\u0410\u0439, \u043C\u0438\u043C\u043E. \u0417\u0432\u0435\u0440\u0451\u043A
    \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0432\u0430\u0435\u0442\u0441\u044F."
  - "\u041F\u0440\u043E\u043C\u0430\u0445! \u041D\u043E \u0441\u0442\u0430\u0442\u0443\u0441
    \u0437\u0432\u0435\u0440\u044C\u043A\u0430 \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B."
  - "\u041C\u0438\u043C\u043E, \u0437\u0430\u0442\u043E \u0431\u0435\u0437 \u0437\u0430\u043D\u0443\u0434\u043D\u044B\u0445
    \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u0432."
  - "\u041C\u0438\u043C\u043E! \u0417\u0432\u0435\u0440\u0451\u043A \u043F\u0440\u043E\u0441\u0442\u043E
    \u0440\u0435\u0448\u0438\u043B \u043F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0443\u0442\u044C."
  - "\u041F\u0440\u043E\u043C\u0430\u0445, \u043D\u043E \u0437\u0432\u0435\u0440\u0451\u043A
    \u0434\u0443\u0448\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438."
  - "\u041C\u0438\u043C\u043E! \u041E\u0434\u0438\u043D \u043F\u0440\u043E\u043C\u0430\u0445
    \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F."
  - "\u041F\u0440\u043E\u043C\u0430\u0445! \u0413\u0435\u043D\u0438\u0438, \u043D\u0435
    \u0437\u043B\u043E\u0440\u0430\u0434\u0441\u0442\u0432\u0443\u0439\u0442\u0435."
  - "\u041C\u0438\u043C\u043E, \u0437\u0430\u0442\u043E \u0437\u0432\u0435\u0440\u0451\u043A
    \u043A\u0440\u0430\u0441\u0438\u0432\u0435\u0435 \u0432\u0441\u0435\u0445."
  - "\u041F\u0440\u043E\u043C\u0430\u0445! \u0417\u0430\u0442\u043E \u0431\u0435\u0437
    \u0435\u0434\u0438\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u0447\u043A\u0438
    \u043A\u043E\u0434\u0430."
  - "\u0417\u0432\u0435\u0440\u0451\u043A \u0438\u0433\u0440\u0430\u0435\u0442 \u0434\u043B\u044F
    \u0434\u0443\u0448\u0438, \u043D\u0435 \u0434\u043B\u044F \u043E\u0447\u043A\u043E\u0432."
  - "\u041F\u0440\u043E\u043C\u0430\u0445, \u043D\u043E \u0445\u0430\u0440\u0438\u0437\u043C\u0430
    \u0432\u0441\u0451 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u0443\u0435\u0442."
