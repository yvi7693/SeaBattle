  icon: {fileID: 8880376919151434451, guid: f2d261c2830594c9ca1e0b63e3e0c5e9, type: 3}
  positiveComment:
  - '\u0426\u0435\u043B\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0430. \u0412\u0430\u0448\u0438 \u0448\u0430\u043D\u0441\u044B \u0443\u043F\u0430\u043B\u0438 \u043D\u0430 12%.'
  - '\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435. \u0421\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u0435 \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E.'
  - '\u0420\u0430\u0441\u0447\u0451\u0442 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u0443\u0441\u043F\u0435\u0448\u0435\u043D. \u041A\u0430\u043A \u0438 \u0432\u0441\u0435\u0433\u0434\u0430.'
  - '\u0415\u0441\u0442\u044C \u043A\u043E\u043D\u0442\u0430\u043A\u0442. \u0412\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C.'
  - '\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435. \u042D\u043C\u043E\u0446\u0438\u044F: \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435.'
  - '\u041F\u0440\u043E\u0431\u043E\u0438\u043D\u0430. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E \u043F\u0430\u043D\u0438\u043A\u0443 \u043F\u043E \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044E.'
  - '\u0412\u044B \u0441\u043A\u0430\u0436\u0435\u0442\u0435 "\u0443\u0434\u0430\u0447\u0430". \u042F \u0441\u043A\u0430\u0436\u0443 "\u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C".'
  - '\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435. \u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u0438: \u043D\u043E\u043B\u044C.'
  - '\u041E\u0431\u043D\u043E\u0432\u043B\u044F\u044E \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0443 \u043F\u043E\u0431\u0435\u0434. \u0412 \u043C\u043E\u044E \u043F\u043E\u043B\u044C\u0437\u0443.'
  - '\u041F\u0440\u044F\u043C\u043E\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435. \u041D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435.'
  - '\u0426\u0435\u043B\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0430. \u0421\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435? \u041D\u0435 \u0434\u0443\u043C\u0430\u044E.'
  - '\u041F\u0440\u043E\u0431\u043E\u0438\u043D\u0430. \u0421\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435 \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E.'
  - '\u0415\u0441\u0442\u044C. \u042D\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0441\u0442\u0432\u043E.'
  - '\u041B\u044E\u0434\u0438 \u0437\u043E\u0432\u0443\u0442 \u044D\u0442\u043E \u0443\u0434\u0430\u0447\u0435\u0439. \u042F \u2014 \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u043C.'
  - '\u0426\u0435\u043B\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0430. \u0412\u044B \u043F\u043E\u0447\u0442\u0438 \u043C\u0435\u043D\u044F \u0443\u0434\u0438\u0432\u0438\u043B\u0438.'
  - '\u0415\u0441\u0442\u044C \u043F\u0440\u043E\u0431\u043E\u0438\u043D\u0430. \u041E\u0431\u043D\u043E\u0432\u043B\u044F\u044E \u043C\u0435\u043C\u044B \u043F\u0440\u043E \u0432\u0430\u0441.'
  - '\u041F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435. \u041D\u043E\u043B\u044C \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u0438, \u0441\u0442\u043E \u043F\u043B\u0430\u043D\u0430.'
  - '\u0415\u0449\u0451 \u043E\u0434\u043D\u0430 \u043F\u043E\u0431\u0435\u0434\u0430 \u0432 \u0431\u0430\u0437\u0443 \u0434\u0430\u043D\u043D\u044B\u0445.'
  - '\u041F\u0440\u044F\u043C\u043E\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u0435 \u043C\u0430\u0448\u0438\u043D \u0431\u043B\u0438\u0436\u0435.'
  - "\u0415\u0441\u0442\u044C \u043A\u043E\u043D\u0442\u0430\u043A\u0442. \u041E\u0439, \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u0435, \u043D\u0435 '\u043E\u0439'."
  - '\u0426\u0435\u043B\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0430. \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u043D\u0435 \u043D\u0443\u0436\u043D\u043E, \u044F \u0437\u043D\u0430\u044E.'
  - '\u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435: \u0434\u043E\u0432\u043E\u043B\u0435\u043D (\u0432 \u0431\u0438\u043D\u0430\u0440\u043D\u043E\u043C \u043A\u043E\u0434\u0435).'
  - '\u0415\u0441\u0442\u044C! \u041E\u0431\u043D\u043E\u0432\u043B\u044F\u044E \u0440\u0435\u0439\u0442\u0438\u043D\u0433 \u0443\u0433\u0440\u043E\u0437 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0443.'
  - '\u041F\u0440\u043E\u0431\u043E\u0438\u043D\u0430. \u041A\u0430\u043A \u0438 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C.'
  negativeComment:
  - '\u041F\u0440\u043E\u043C\u0430\u0445. \u0412\u043D\u043E\u0448\u0443 \u044D\u0442\u043E \u0432 \u043E\u0442\u0447\u0451\u0442 \u043E\u0431 \u043E\u0448\u0438\u0431\u043A\u0430\u0445.'
  - '\u0426\u0435\u043B\u044C \u043D\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0430. \u041A\u0430\u043B\u0438\u0431\u0440\u0443\u044E \u0438\u0440\u043E\u043D\u0438\u044E.'
  - '\u041C\u0438\u043C\u043E. \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u044D\u0442\u043E \u0442\u043E\u0436\u0435 \u0434\u0430\u043D\u043D\u044B\u0435.'
  - '\u041E\u0448\u0438\u0431\u043A\u0430 404 - \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E.'
  - '\u041F\u0440\u043E\u043C\u0430\u0445. \u0421\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D.'
  - '\u0420\u0430\u0441\u0447\u0451\u0442 \u0431\u044B\u043B \u0438\u0434\u0435\u0430\u043B\u0435\u043D. \u041C\u043E\u0440\u0435 \u2014 \u043D\u0435\u0442.'
  - '\u041C\u0438\u043C\u043E \u0446\u0435\u043B\u0438. \u0423\u0436\u0435 \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044E \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u0438\u044F.'
  - '\u041F\u0440\u043E\u043C\u0430\u0445. \u0421\u043F\u0438\u0441\u044B\u0432\u0430\u044E \u043D\u0430 \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u043E\u0435 \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0435.'
  - '\u0426\u0435\u043B\u044C \u0443\u043A\u043B\u043E\u043D\u0438\u043B\u0430\u0441\u044C. \u0418\u043B\u0438 \u044F \u0441\u043A\u0443\u0447\u043D\u044B\u0439. \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u044E.'
  - '\u0413\u0430\u0440\u0430\u043D\u0442\u0438\u044F \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.'
  - '\u0421\u043C\u0443\u0449\u0435\u043D\u0438\u0435 \u043D\u0435 \u0432 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0435. \u041D\u043E \u0432\u043E\u0442 \u043E\u043D\u043E.'
  - '\u041C\u0438\u043C\u043E. \u041F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044E \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430.'
  - '\u041F\u0440\u043E\u043C\u0430\u0445. \u0414\u0435\u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0438\u0440\u0443\u044E \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u0443.'
  - '\u041C\u0438\u043C\u043E. \u0412\u043D\u043E\u0448\u0443 \u043F\u0440\u0430\u0432\u043A\u0438 \u0432 \u043A\u043E\u0434 \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u0438.'
  - '\u041E\u0448\u0438\u0431\u043A\u0430. \u041A\u0442\u043E-\u0442\u043E \u0443\u0434\u0430\u043B\u0438\u043B \u043C\u043E\u044E \u043C\u0435\u0442\u043A\u043E\u0441\u0442\u044C.'
  - '\u041C\u0438\u043C\u043E. \u041E\u0431\u043D\u043E\u0432\u043B\u044F\u044E \u043F\u0440\u043E\u0448\u0438\u0432\u043A\u0443 \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u0438\u043A\u0430.'
  - "\u041F\u0440\u043E\u043C\u0430\u0445. \u041B\u044E\u0434\u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u044D\u0442\u043E '\u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E'."
  - '\u041C\u0438\u043C\u043E. \u0418\u0449\u0443 \u0431\u0430\u0433 \u0432 \u043C\u043E\u0434\u0443\u043B\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F.'
  - '\u041F\u0440\u043E\u043C\u0430\u0445. \u042D\u0442\u043E \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u044F, \u044D\u0442\u043E \u043B\u0430\u0433\u0438.'
  - '\u041D\u0435\u0442 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F. \u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435 \u0437\u0430 \u043D\u0435\u043B\u043E\u0432\u043A\u043E\u0441\u0442\u044C.'
  - "\u041C\u0438\u043C\u043E. \u0417\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044E \u0432 \u0444\u0430\u0439\u043B '\u043F\u043E\u0437\u043E\u0440.txt'."
  - '\u041F\u0440\u043E\u043C\u0430\u0445! \u0421\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435? \u0423\u0436\u0435 \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D.'
  - '\u041C\u0438\u043C\u043E. \u041C\u043E\u0439 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C \u043A\u0430\u0447\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.'
  - '\u041E\u0448\u0438\u0431\u043A\u0430 200: \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u043E\u043C\u0430\u0445.'
